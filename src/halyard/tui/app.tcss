Screen {
    layout: vertical;
}

#body {
    height: 1fr;
}

#main-pane {
    width: 2fr;
    height: 1fr;
}

#side-pane {
    width: 1fr;
    height: 1fr;
}

#session-feed,
#project-pane,
#budget-pane,
#model-pane {
    border: solid $primary;
    padding: 1;
}

#branch-modal {
    width: 48;
    max-height: 20;
    margin: 2 4;
    padding: 1 2;
    border: solid $accent;
    background: $surface;
}

#branch-title {
    text-style: bold;
    margin-bottom: 1;
}

#help-modal {
    width: 42;
    max-height: 18;
    margin: 2 4;
    padding: 1 2;
    border: solid $accent;
    background: $surface;
}

#help-title {
    text-style: bold;
    margin-bottom: 1;
}

.budget-ok {
    color: green;
}

.budget-warn {
    color: yellow;
}

.budget-high {
    color: red;
}

.budget-over {
    color: red;
    text-style: blink;
}
